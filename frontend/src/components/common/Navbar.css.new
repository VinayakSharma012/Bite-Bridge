/* ============================================
   NAVBAR COMPONENT - LUXURY ZOMATO STYLE
   ============================================ */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 64px;
  background: var(--color-surface);
  border-bottom: 1px solid rgba(232, 0, 76, 0.1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 1000;
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
}

.navbar-container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  gap: var(--space-6);
}

/* ── LOGO ── */
.navbar-logo {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
  text-decoration: none;
  color: var(--color-text-primary);
}

.logo-emoji {
  font-size: 1.5rem;
}

.logo-text {
  font-size: 1.25rem;
  font-weight: var(--font-weight-bold);
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -0.02em;
}

/* ── DESKTOP NAVIGATION PILLS ── */
.navbar-nav-desktop {
  display: none;
  align-items: center;
  gap: var(--space-4);
  list-style: none;
  margin: 0;
  padding: 0;
}

@media (min-width: 1024px) {
  .navbar-nav-desktop {
    display: flex;
  }
}

.nav-pill {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  text-decoration: none;
  color: var(--color-text-secondary);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: var(--transition-fast);
}

.nav-pill:hover {
  color: var(--color-primary);
  background: var(--color-surface-muted);
}

.nav-pill-active {
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  color: var(--color-surface);
  font-weight: var(--font-weight-semibold);
}

/* ── RIGHT SECTION ── */
.navbar-right {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-left: auto;
}

/* ── CART ICON WITH BADGE ── */
.navbar-cart-btn {
  position: relative;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-muted);
  border: none;
  border-radius: var(--radius-pill);
  color: var(--color-primary);
  cursor: pointer;
  transition: var(--transition-fast);
  text-decoration: none;
}

.navbar-cart-btn:hover {
  background: var(--color-border);
  transform: scale(1.05);
}

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  width: 20px;
  height: 20px;
  background: var(--color-primary);
  color: var(--color-surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.65rem;
  font-weight: var(--font-weight-bold);
  border: 2px solid var(--color-surface);
  animation: bounce 0.6s ease-in-out;
}

@keyframes bounce {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
}

/* ── BELL ICON WITH UNREAD DOT ── */
.navbar-bell-btn {
  position: relative;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-muted);
  border: none;
  border-radius: var(--radius-pill);
  color: var(--color-primary);
  cursor: pointer;
  transition: var(--transition-fast);
}

.navbar-bell-btn:hover {
  background: var(--color-border);
  transform: scale(1.05);
}

.unread-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 8px;
  height: 8px;
  background: var(--color-error);
  border-radius: 50%;
  border: 2px solid var(--color-surface);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
  }
}

/* ── USER AVATAR ── */
.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  color: var(--color-surface);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: var(--font-weight-bold);
  font-size: 0.875rem;
  transition: var(--transition-fast);
}

.user-avatar:hover {
  transform: scale(1.08);
  box-shadow: 0 4px 12px rgba(232, 0, 76, 0.3);
}

/* ── USER DROPDOWN MENU ── */
.user-menu-wrapper {
  position: relative;
}

.user-dropdown {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  min-width: 280px;
  background: var(--color-surface);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(232, 0, 76, 0.1);
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 32px rgba(232, 0, 76, 0.12);
  padding: var(--space-4);
  z-index: 1001;
}

.dropdown-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--color-border);
  margin-bottom: var(--space-4);
}

.dropdown-user-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  color: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}

.dropdown-user-name {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin: 0;
  font-size: var(--text-sm);
}

.dropdown-user-email {
  color: var(--color-text-hint);
  margin: 0;
  font-size: var(--text-xs);
}

.dropdown-divider {
  height: 1px;
  background: var(--color-border);
  margin: var(--space-3) 0;
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: var(--text-sm);
  cursor: pointer;
  transition: var(--transition-fast);
  width: 100%;
  text-align: left;
}

.dropdown-item:hover {
  background: var(--color-surface-muted);
  color: var(--color-primary);
}

.dropdown-logout {
  color: var(--color-error);
}

.dropdown-logout:hover {
  background: rgba(239, 68, 68, 0.1);
}

/* ── AUTH BUTTONS (UNAUTHENTICATED) ── */
.auth-buttons-desktop {
  display: none;
  align-items: center;
  gap: var(--space-3);
}

@media (min-width: 1024px) {
  .auth-buttons-desktop {
    display: flex;
  }
}

.btn-signin {
  padding: var(--space-2) var(--space-5);
  border: 2px solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  cursor: pointer;
  transition: var(--transition-fast);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-signin:hover {
  background: var(--color-primary);
  color: var(--color-surface);
}

.btn-signup {
  padding: var(--space-2) var(--space-5);
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  cursor: pointer;
  transition: var(--transition-fast);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.btn-signup:hover {
  transform: scale(1.02);
  box-shadow: var(--shadow-md);
}

/* ── HAMBURGER MENU (MOBILE) ── */
.navbar-hamburger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: var(--color-surface-muted);
  border: none;
  border-radius: var(--radius-pill);
  color: var(--color-primary);
  cursor: pointer;
  transition: var(--transition-fast);
}

@media (min-width: 1024px) {
  .navbar-hamburger {
    display: none;
  }
}

.navbar-hamburger:hover {
  background: var(--color-border);
  transform: scale(1.05);
}

/* ── MOBILE MENU BACKDROP ── */
.navbar-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1099;
}

/* ── MOBILE DRAWER MENU ── */
.mobile-drawer {
  position: fixed;
  right: 0;
  top: 0;
  width: min(100%, 320px);
  height: 100vh;
  background: var(--color-surface);
  box-shadow: -4px 0 32px rgba(0, 0, 0, 0.12);
  z-index: 1100;
  overflow-y: auto;
  padding-top: 80px;
  padding: var(--space-6);
  padding-top: 80px;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

@media (min-width: 1024px) {
  .mobile-drawer {
    display: none;
  }
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
}

.mobile-nav-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  border-bottom: 1px solid var(--color-border);
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  transition: var(--transition-fast);
  text-align: left;
}

.mobile-nav-link:hover {
  color: var(--color-primary);
  background: var(--color-surface-muted);
  padding-left: calc(var(--space-4) + 4px);
}

/* ── MOBILE SHORTCUTS ── */
.mobile-shortcuts {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-3) 0;
  margin: var(--space-4) 0;
}

.mobile-shortcut {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  transition: var(--transition-fast);
}

.mobile-shortcut:hover {
  color: var(--color-primary);
  background: var(--color-surface-muted);
}

/* ── MOBILE DIVIDER ── */
.mobile-divider {
  height: 1px;
  background: var(--color-border);
  margin: 0;
}

/* ── MOBILE AUTH SECTION ── */
.mobile-auth {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding-top: var(--space-4);
}

.mobile-user-info {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  background: var(--color-surface-muted);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-4);
}

.mobile-user-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  color: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}

.mobile-user-name {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin: 0;
  font-size: var(--text-sm);
}

.mobile-user-email {
  color: var(--color-text-hint);
  margin: 0;
  font-size: var(--text-xs);
}

.mobile-auth-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: var(--text-sm);
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: var(--transition-fast);
}

.mobile-auth-link:hover {
  background: var(--color-surface-muted);
  color: var(--color-primary);
}

.mobile-logout-btn {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: transparent;
  border: none;
  color: var(--color-error);
  text-decoration: none;
  font-size: var(--text-sm);
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: var(--transition-fast);
  width: 100%;
  text-align: left;
}

.mobile-logout-btn:hover {
  background: rgba(239, 68, 68, 0.1);
}

.btn-mobile-signin {
  width: 100%;
  padding: var(--space-3) var(--space-4);
  border: 2px solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  cursor: pointer;
  transition: var(--transition-fast);
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-mobile-signin:hover {
  background: var(--color-primary);
  color: var(--color-surface);
}

.btn-mobile-signup {
  width: 100%;
  padding: var(--space-3) var(--space-4);
  background: linear-gradient(135deg, #E8004C 0%, #FF6B9D 100%);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  cursor: pointer;
  transition: var(--transition-fast);
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.btn-mobile-signup:hover {
  transform: scale(1.02);
  box-shadow: var(--shadow-md);
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .navbar-container {
    gap: var(--space-4);
  }

  .logo-text {
    font-size: 1.125rem;
  }

  .navbar-icon-btn {
    width: 40px;
    height: 40px;
    font-size: 1.125rem;
  }
}

@media (max-width: 640px) {
  .logo-text {
    font-size: 1rem;
  }

  .navbar {
    height: 56px;
  }

  .navbar-container {
    padding: 0 var(--space-3);
  }
}