# -------------------------------
# BiteBridge production env sample
# -------------------------------

# Backend
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
SPRING_DATA_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=Cluster0
SPRING_DATA_MONGODB_DATABASE=bitebridge
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.onrender.com

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Frontend build-time API base URL
VITE_API_BASE_URL=/api
